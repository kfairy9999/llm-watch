# Only the Groq example and `llmwatch eval run --provider groq` read this.
# Tests and the dashboard do not need a key.
GROQ_API_KEY=

# Optional model override for examples/groq_watch.py
# GROQ_MODEL=llama-3.1-8b-instant

# Ledger path. Defaults to data/llmwatch.db
LLMWATCH_DB=data/llmwatch.db

# Set to 0 to stop `llmwatch serve` from seeding an empty database.
LLMWATCH_SEED=1

# Optional JSON price table. Defaults to the bundled illustrative table.
# LLMWATCH_PRICES=./my-prices.json

# Comma-separated browser origins for the API. Default allows any origin.
# LLMWATCH_CORS=*

# Optional MongoDB ledger. Leave these unset to keep the SQLite file above.
# pip install "llm-watch[mongodb]"
# A free Atlas M0 URI is enough. This repo does not ship a cluster.
# Put the URI on the API / CLI / proxy only. The dashboard must not see it.
# LLMWATCH_MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net
# LLMWATCH_MONGODB_DB=llmwatch

# Dashboard container only. Empty means same-origin /api (nginx or the Vite proxy).
# API_BASE=https://your-llm-watch-api.example
